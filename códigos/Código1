menu = """

[d] Depositar
[s] Sacar
[e] Extrato
[q] Sair

=> """

saldo = 0
limite = 500
extrato = ""
numero_saques = 0
LIMITE_SAQUES = 3

while True:

    opcao = input(menu)
    if opcao == "d":
        deposito = float(input("Informe o valor do deposito\n"))
        if deposito > 0:
            saldo += deposito
            extrato += (f"deposito de: R${deposito:.2f}\n")
            print ("Deposito realizado com sucesso!")
        else:
            print ("Erro, valor invalido, tente novamente.")

        
    
    elif opcao == "s":
        saque = float(input("Informe o valor do saque\n")) 
        if numero_saques >= LIMITE_SAQUES:
            print ("Maximo diario de saques excedido.")
        elif saldo < saque:
            print("Saldo insuficiente.")
        elif saque > limite:
            print ("Limite ultrapassado.")
        elif saque>0:
            extrato += (f"saque de: R${saque:.2f}\n")
            saldo -= saque
            numero_saques += 1
            print ("saque realizado com sucesso!")
        else:
            print("Valor invalido, tente novamente.")
    
    elif opcao == "e":
        print (f"extrato:\n{extrato}")
        print (f"Saldo total:\nR${saldo:.2f}")

    elif opcao == "q":
        break

    else:
        print("Operação inválida, por favor selecione novamente a operação desejada.")
